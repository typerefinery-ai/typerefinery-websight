# graphify excludes for typerefinery-websight (Maven / WebSight CMS)

# Build output and dependencies
target/
**/target/
node_modules/
**/node_modules/
dist/
**/dist/
build/

# Maven wrapper binaries
.mvn/wrapper/

# Bundled Node.js runtime (downloaded by frontend build)
node/
**/node/

# Generated frontend assets / copied build resources
application/frontend/assets/
application/frontend/src/main/resources/

# Vendor icon/font asset sets (each SVG costs a vision pass, none carry design intent)
application/frontend/src/static/clientlibs/vendor/fontawesome/
application/frontend/src/static/clientlibs/vendor/primevue/primeicons/
application/frontend/src/static/clientlibs/vendor/primevue/styles/fonts/
application/frontend/src/static/clientlibs/vendor/primevue/resources/images/
application/frontend/src/static/clientlibs/vendor/map/leafletmap/images/
**/clientlibs/resources/stix2viz/icons/

# Sling/JCR binary renditions (duplicates of the authored asset next to them)
**/_jcr_content/renditions/

# Lockfiles and generated metadata (huge, no graph value)
package-lock.json

# Runtime environment data (docker volumes, local instance state)
environment/local/

# Logs
logs/
*.log

# IDE / editor config
.idea/
.vscode/
.cursor/

# graphify's own output
graphify-out/
