<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:ws="http://ds.pl/websight" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="ws:Page">
    <jcr:content
        jcr:lastModified="{Date}2025-01-01T00:00:00.000+00:00"
        jcr:lastModifiedBy="system"
        jcr:primaryType="ws:PageContent"
        jcr:title="Label"
        sling:resourceType="typerefinery/components/structure/page"
        ws:template="/apps/typerefinery/templates/page">
        <rootcontainer
            jcr:primaryType="nt:unstructured"
            sling:resourceType="typerefinery/components/layout/fixedrootcontainer">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="typerefinery/components/layout/header"
                id="header_LABEL_SHOWCASE"/>
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="typerefinery/components/layout/container"
                id="container_LABEL_SHOWCASE">
                <form1
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="typerefinery/components/forms/form"
                    flowapi_sampledata="/apps/typerefinery/components/forms/form/templates/flowsample.json"
                    flowapi_template="/apps/typerefinery/components/forms/form/templates/flowform-service.json"
                    id="form1_LABEL_SHOWCASE">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/content/title"
                        headingSize="h4"
                        id="title_LABEL_BASIC"
                        title="Basic Label Usage"/>
                    <input_1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/input"
                        id="input_1_LABEL_BASIC">
                        <label
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/label"
                            id="label_1_LABEL_BASIC"
                            label="Enter Your Name"
                            forId="field_name_example"/>
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/input"
                            id="field_name_example"
                            inputType="text"
                            placeholder="John Doe"/>
                    </input_1>
                    <title2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/content/title"
                        headingSize="h4"
                        id="title_LABEL_HIDDEN"
                        title="Label with Hidden Option"/>
                    <input_2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/input"
                        id="input_2_LABEL_HIDDEN">
                        <label
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/label"
                            hideLabel="true"
                            id="label_2_LABEL_HIDDEN"
                            label="Hidden Label (Accessible to Screen Readers)"
                            forId="field_hidden_label_example"/>
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/input"
                            id="field_hidden_label_example"
                            inputType="text"
                            placeholder="Label is hidden but accessible"/>
                    </input_2>
                    <title3
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/content/title"
                        headingSize="h4"
                        id="title_LABEL_STANDALONE"
                        title="Standalone Label Component"/>
                    <label_standalone
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/fields/label"
                        id="label_standalone_1"
                        label="This is a standalone label component"
                        forId="standalone_input_example"/>
                    <input_standalone
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/fields/input"
                        id="standalone_input_example"
                        inputType="text"
                        placeholder="Input associated with standalone label"/>
                    <title4
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/content/title"
                        headingSize="h4"
                        id="title_LABEL_GROUP"
                        title="Label for Form Field Groups"/>
                    <label_group
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/fields/label"
                        id="label_group_1"
                        label="Contact Information"/>
                    <input_group_1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/input"
                        id="input_group_1">
                        <label
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/label"
                            id="label_email"
                            label="Email Address"/>
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/input"
                            id="field_email"
                            inputType="email"
                            placeholder="email@example.com"/>
                    </input_group_1>
                    <input_group_2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="typerefinery/components/forms/input"
                        id="input_group_2">
                        <label
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/label"
                            id="label_phone"
                            label="Phone Number"/>
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="typerefinery/components/forms/fields/input"
                            id="field_phone"
                            inputType="tel"
                            placeholder="+1 234 567 8900"/>
                    </input_group_2>
                </form1>
            </container>
        </rootcontainer>
    </jcr:content>
</jcr:root>
