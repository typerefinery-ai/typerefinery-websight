# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Log files
*.log

# Package files
*.jar

# Maven
**/target

# JetBrains IDE
.idea/
*.iml

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Project specific
**/launcher

# Reference files from WS
_reference

# --- added 2026-08-11, alpha-launch docs/issues/0090 -------------------------
# CLAUDE.md forbids committing secrets or generated output, but nothing enforced it:
# .env (holding a live API key) and graphify-out/ were merely UNTRACKED in every repo,
# so a single `git add -A` would have committed them.
.env
.env.*
!.env.example
graphify-out/

# local e2e scratch: 50 MB flow-DB backups taken before fix scripts, and stderr dumps
e2e/.backup-*/
e2e/.dump-err

# screenshots written by e2e probes/walks (never committed), and outputs of e2e scripts run from the repo root
/*.png
e2e/*.png
/audit-content-divergence.json
/audit-form-save-legs.json
/indicator-create.json
