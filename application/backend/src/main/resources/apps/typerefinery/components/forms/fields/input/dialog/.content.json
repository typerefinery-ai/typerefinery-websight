{
  "sling:resourceType": "wcm/dialogs/dialog",
  "tabs": {
    "sling:resourceType": "wcm/dialogs/components/tabs",
    "generalTab": {
      "sling:resourceType": "wcm/dialogs/components/tab",
      "label": "General",
      "fieldName": {
        "sling:resourceType": "wcm/dialogs/components/include",
        "path": "/apps/typerefinery/components/forms/form/common/fieldName"
      },
      "placeholder": {
        "sling:resourceType": "wcm/dialogs/components/include",
        "path": "/apps/typerefinery/components/forms/form/common/placeholder"
      },
      "fieldValue": {
        "sling:resourceType": "wcm/dialogs/components/include",
        "path": "/apps/typerefinery/components/forms/form/common/fieldValue"
      },
      "inputType": {
        "sling:resourceType": "wcm/dialogs/components/select",
        "name": "inputType",
        "label": "Type",
        "text": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Text",
          "value": "text"
        },
        "password": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Password",
          "value": "password"
        },
        "email": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Email",
          "value": "email"
        },
        "tel": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Mobile Number",
          "value": "tel"
        },
        "number": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Number",
          "value": "number"
        },
        "range": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Range",
          "value": "range"
        },
        "colourpicker": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Colour Picker",
          "value": "colourpicker"
        },
        "rating": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Rating",
          "value": "rating"
        },
        "date": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Date",
          "value": "date"
        },
        "datetime-local": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Date and Time",
          "value": "datetime-local"
        },
        "time": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Time",
          "value": "time"
        },
        "hidden": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Hidden (but, visible in edit mode)",
          "value": "hidden"
        }
      },
      "rangeMin": {
        "sling:resourceType": "wcm/dialogs/components/numberfield",
        "name": "rangeMin",
        "label": "Range Minimum",
        "default": 0,
        "min": 0,
        "max": 1000,
        "step": 1,
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "range"
        }
      },
      "rangeMax": {
        "sling:resourceType": "wcm/dialogs/components/numberfield",
        "name": "rangeMax",
        "label": "Range Maximum",
        "default": 100,
        "min": 0,
        "max": 1000,
        "step": 1,
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "range"
        }
      },
      "rangeStep": {
        "sling:resourceType": "wcm/dialogs/components/numberfield",
        "name": "rangeStep",
        "label": "Range Step",
        "default": 1,
        "min": 0,
        "max": 100,
        "step": 0.1,
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "range"
        }
      },
      "ratingMaxStars": {
        "sling:resourceType": "wcm/dialogs/components/numberfield",
        "name": "ratingMaxStars",
        "label": "Maximum Stars",
        "default": 5,
        "min": 1,
        "max": 10,
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "rating"
        }
      },
      "ratingAllowHalf": {
        "sling:resourceType": "wcm/dialogs/components/checkbox",
        "name": "ratingAllowHalf",
        "label": "Allow Half Stars",
        "default": true,
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "rating"
        }
      },
      "ratingIconClass": {
        "sling:resourceType": "wcm/dialogs/components/textfield",
        "name": "ratingIconClass",
        "label": "Filled Icon Class",
        "default": "fas fa-star",
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "rating"
        }
      },
      "ratingIconClassEmpty": {
        "sling:resourceType": "wcm/dialogs/components/textfield",
        "name": "ratingIconClassEmpty",
        "label": "Empty Icon Class",
        "default": "far fa-star",
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "rating"
        }
      },
      "ratingIconClassHalf": {
        "sling:resourceType": "wcm/dialogs/components/textfield",
        "name": "ratingIconClassHalf",
        "label": "Half Icon Class",
        "default": "fas fa-star-half-alt",
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "rating"
        }
      },
      "ratingIconColor": {
        "sling:resourceType": "wcm/dialogs/components/textfield",
        "name": "ratingIconColor",
        "label": "Icon Color",
        "default": "#ffc107",
        "description": "Color for rating icons (hex format, e.g., #ffc107)",
        "showIf": {
          "lhs": "inputType",
          "op": "equals",
          "rhs": "rating"
        }
      },
      "dateOutputFormat": {
        "sling:resourceType": "wcm/dialogs/components/select",
        "name": "dateOutputFormat",
        "label": "Output Format",
        "description": "How the date/time value is formatted when submitted",
        "showIf": {
          "lhs": "inputType",
          "op": "in",
          "rhs": ["date", "time", "datetime-local"]
        },
        "iso-8601": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "ISO 8601",
          "value": "iso-8601"
        },
        "iso-date": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "ISO Date",
          "value": "iso-date"
        },
        "iso-time": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "ISO Time",
          "value": "iso-time"
        },
        "us-date": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "US Date (MM/DD/YYYY)",
          "value": "us-date"
        },
        "european-date": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "European Date (DD/MM/YYYY)",
          "value": "european-date"
        },
        "long-date": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Long Date (January 15, 2024)",
          "value": "long-date"
        },
        "unix-timestamp": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Unix Timestamp",
          "value": "unix-timestamp"
        },
        "rfc-3339": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "RFC 3339",
          "value": "rfc-3339"
        },
        "iso-8601-utc": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "ISO 8601 with Z (UTC)",
          "value": "iso-8601-utc"
        },
        "iso-8601-offset": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "ISO 8601 with Offset (+05:00)",
          "value": "iso-8601-offset"
        },
        "custom": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Custom",
          "value": "custom"
        }
      },
      "dateCustomFormat": {
        "sling:resourceType": "wcm/dialogs/components/textfield",
        "name": "dateCustomFormat",
        "label": "Custom Format Pattern",
        "description": "Custom format pattern (e.g., YYYY-MM-DD HH:mm:ss). Only used when Output Format is 'Custom'.",
        "placeholder": "YYYY-MM-DD HH:mm:ss",
        "showIf": {
          "lhs": "inputType",
          "op": "in",
          "rhs": ["date", "time", "datetime-local"]
        }
      },
      "dateTimezone": {
        "sling:resourceType": "wcm/dialogs/components/select",
        "name": "dateTimezone",
        "label": "Input Timezone",
        "description": "Timezone for the input value",
        "default": "browser-local",
        "showIf": {
          "lhs": "inputType",
          "op": "in",
          "rhs": ["date", "time", "datetime-local"]
        },
        "browser-local": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Browser Local",
          "value": "browser-local"
        },
        "utc": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "UTC",
          "value": "utc"
        },
        "custom": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Custom",
          "value": "custom"
        }
      },
      "dateTimezoneCustom": {
        "sling:resourceType": "wcm/dialogs/components/select",
        "name": "dateTimezoneCustom",
        "label": "Custom Timezone",
        "description": "IANA timezone (e.g., America/New_York, Europe/London)",
        "showIf": {
          "lhs": "inputType",
          "op": "in",
          "rhs": ["date", "time", "datetime-local"]
        },
        "america-new-york": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "America/New_York (Eastern Time)",
          "value": "America/New_York"
        },
        "america-los-angeles": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "America/Los_Angeles (Pacific Time)",
          "value": "America/Los_Angeles"
        },
        "europe-london": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Europe/London (British Time)",
          "value": "Europe/London"
        },
        "europe-paris": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Europe/Paris (Central European Time)",
          "value": "Europe/Paris"
        },
        "asia-tokyo": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Asia/Tokyo (Japan Standard Time)",
          "value": "Asia/Tokyo"
        }
      },
      "dateOutputTimezone": {
        "sling:resourceType": "wcm/dialogs/components/select",
        "name": "dateOutputTimezone",
        "label": "Output Timezone",
        "description": "Timezone for the output value when form is submitted",
        "default": "preserve-input",
        "showIf": {
          "lhs": "inputType",
          "op": "in",
          "rhs": ["date", "time", "datetime-local"]
        },
        "preserve-input": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Preserve Input",
          "value": "preserve-input"
        },
        "utc": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "UTC",
          "value": "utc"
        },
        "custom": {
          "sling:resourceType": "wcm/dialogs/components/select/selectitem",
          "label": "Custom",
          "value": "custom"
        }
      }
    },
    "eventTab": {
      "sling:resourceType": "wcm/dialogs/components/tab",
      "label": "Events",
      "warning": {
        "sling:resourceType": "wcm/dialogs/components/include",
        "path": "/apps/typerefinery/components/dialog/tabs/event/warning"
      },
      "info": {
        "sling:resourceType": "wcm/dialogs/components/include",
        "path": "/apps/typerefinery/components/dialog/tabs/event/info"
      },
      "event": {
        "sling:resourceType": "wcm/dialogs/components/multifield",
        "ws:disallowedContext": ["edit:panel"],
        "name": "_events_",
        "description": "Pick generic event or specify custom event to which component action will be mapped.",
        "label": "Events",
        "topic": {
          "sling:resourceType": "wcm/dialogs/components/include",
          "path": "/apps/typerefinery/components/dialog/tabs/event/event/topic"
        },
        "type": {
          "sling:resourceType": "wcm/dialogs/components/include",
          "path": "/apps/typerefinery/components/dialog/tabs/event/event/type"
        },
        "eventAction": {
          "sling:resourceType": "typerefinery/components/dialog/eventactions",
          "name": "action",
          "label": "Component Action",
          "description": "Which component action to map to event."
        },
        "eventName": {
          "sling:resourceType": "wcm/dialogs/components/include",
          "path": "/apps/typerefinery/components/dialog/tabs/event/event/eventName"
        },
        "eventNameCustom": {
          "sling:resourceType": "wcm/dialogs/components/include",
          "path": "/apps/typerefinery/components/dialog/tabs/event/event/eventNameCustom"
        },
        "eventConfig": {
          "sling:resourceType": "wcm/dialogs/components/include",
          "path": "/apps/typerefinery/components/dialog/tabs/event/event/eventConfig"
        }
      }
    },
    "validationTab": {
      "sling:resourceType": "wcm/dialogs/components/include",
      "path": "/apps/typerefinery/components/dialog/tabs/validation"
    },
    "gridTab": {
      "sling:resourceType": "wcm/dialogs/components/include",
      "path": "/apps/typerefinery/components/dialog/tabs/grid"
    },
    "styleTab": {
      "sling:resourceType": "wcm/dialogs/components/include",
      "path": "/apps/typerefinery/components/dialog/tabs/style"
    },
    "ariaTab": {
      "sling:resourceType": "wcm/dialogs/components/include",
      "path": "/apps/typerefinery/components/dialog/tabs/aria"
    }
  }
}